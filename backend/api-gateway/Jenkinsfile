pipeline {
    agent any
    
    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        DOCKER_HUB_USERNAME = 'bhavy0949'
        SERVICE_NAME = 'api-gateway'
        GIT_REPO = 'https://github.com/bhavy0949/Red-Bus.git'
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
    }
    
    stages {
        stage('Clone Repository') {
            steps {
                echo "========== Cloning Repository for ${SERVICE_NAME} =========="
                git branch: 'main', url: "${GIT_REPO}"
                script {
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.IMAGE_NAME = "${DOCKER_HUB_USERNAME}/redbus-${SERVICE_NAME}:${env.GIT_TAG}"
                    env.LATEST_IMAGE = "${DOCKER_HUB_USERNAME}/redbus-${SERVICE_NAME}:latest"
                    env.SKIP_BUILD = "false"
                    echo "🚀 Proceeding with build for ${env.IMAGE_NAME}"
                }
            }
        }

        stage('Build') {
            when { environment name: 'SKIP_BUILD', value: 'false' }
            steps {
                echo "========== Building ${SERVICE_NAME} =========="
                dir("backend/${SERVICE_NAME}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Test') {
            when { environment name: 'SKIP_BUILD', value: 'false' }
            steps {
                echo "========== Testing ${SERVICE_NAME} =========="
                dir("backend/${SERVICE_NAME}") {
                    sh 'mvn test'
                }
            }
        }
        
        stage('Build Docker Image') {
            when { environment name: 'SKIP_BUILD', value: 'false' }
            steps {
                echo "========== Building Docker Image for ${SERVICE_NAME} =========="
                dir("backend/${SERVICE_NAME}") {
                    sh "docker build -t ${env.IMAGE_NAME} -t ${env.LATEST_IMAGE} ."
                }
            }
        }
        
        stage('Push to Docker Hub') {
            when { environment name: 'SKIP_BUILD', value: 'false' }
            steps {
                echo "========== Pushing ${SERVICE_NAME} to Docker Hub =========="
                script {
                    def pushStatus = sh(script: """
                        echo \$DOCKER_HUB_CREDENTIALS_PSW | docker login -u \$DOCKER_HUB_CREDENTIALS_USR --password-stdin
                        docker push ${env.IMAGE_NAME}
                        docker push ${env.LATEST_IMAGE}
                        docker logout
                    """, returnStatus: true)

                    if (pushStatus != 0) {
                        echo "⚠️ Docker push failed with status ${pushStatus} — continuing without failing the build."
                    }
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ ${SERVICE_NAME} pipeline succeeded!"
        }
        failure {
            echo "❌ ${SERVICE_NAME} pipeline failed!"
        }
    }
}
